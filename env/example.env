# Copy to env/dev.env (and env/prod.env for release builds) and fill in.
# These values are NOT secrets: Firebase client config is public by design and
# protected by Security Rules. Never put service-account keys here.

# --- Firebase (Project settings > Your apps) ---
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.techorbit.tourBoard

# --- Google Sign-In ---
# OAuth "Web client" ID (needed on Android to obtain an ID token).
GOOGLE_SERVER_CLIENT_ID=
# iOS OAuth client ID (from GoogleService-Info.plist CLIENT_ID).
GOOGLE_IOS_CLIENT_ID=

# --- Invite links ---
# Base for shareable links; the app appends /<code>.
INVITE_LINK_BASE=https://tourboard.app/join

# --- Map tiles (respect the provider's usage policy and attribution) ---
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# --- Place search ---
# nominatim | none   (none = manual place entry only)
PLACE_SEARCH_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact email sent in the User-Agent, required by the Nominatim policy.
PLACE_SEARCH_CONTACT_EMAIL=

# --- Local development ---
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=10.0.2.2
