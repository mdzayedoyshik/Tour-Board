# Optional overrides. Copy to env/dev.env (and env/prod.env for release
# builds). Every key has a default, so these files may be empty or absent.
#
# Firebase is configured with the FlutterFire CLI (`flutterfire configure`),
# not here. Never put service-account keys or other secrets in these files.

# --- Invite links ---
# Base for shareable links; the app appends /<code>.
INVITE_LINK_BASE=https://tourboard.app/join

# --- Map tiles (respect the provider's usage policy and attribution) ---
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# --- Place search ---
# nominatim | none   (none = manual place entry only)
PLACE_SEARCH_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact email sent in the User-Agent, required by the Nominatim policy.
PLACE_SEARCH_CONTACT_EMAIL=

# --- Local development ---
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=10.0.2.2
