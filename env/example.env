# Optional overrides. Copy to env/dev.env (and env/prod.env for release
# builds). Every key has a default, so these files may be empty or absent.
#
# Firebase is configured with the FlutterFire CLI (`flutterfire configure`),
# not here. Never put service-account keys or other secrets in these files.
# The Google Maps app key is a build setting, not an env value (see
# docs/SETUP_GUIDE.md).

# Tour Board backend (push notifications, cleanup, place search).
API_BASE_URL=https://tour-board-backend.onrender.com

# --- Local development ---
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=10.0.2.2
